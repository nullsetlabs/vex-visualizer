# Research folder — never commit credentials or local-only artifacts

# --- Credentials (CRITICAL — never commit) ---
*token*.txt
*token*.json
*.token
*.pem
.env
.env.*
*secret*
*credentials*
# Allow this gitignore itself and documentation that happens to match
!.gitignore

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# --- Local logs + scratch ---
*_log.txt
ingest_log.txt
clean_log.txt
scratch/
tmp/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
